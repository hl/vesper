#!/usr/bin/env bash
set -euo pipefail

# Skip quality gates if no code files are staged
staged_code=$(git diff --cached --name-only -- 'src/**' 'tests/**' '*.ts' 'biome.json' 'tsconfig.json' 'package.json')
if [ -z "$staged_code" ]; then
  echo "==> No code changes staged, skipping quality gates."
  exit 0
fi

echo "==> Running quality gates..."

echo "--- Typecheck"
bunx tsc --noEmit

echo "--- Lint + format check"
bunx biome check .

echo "--- Tests"
bun test

echo "==> All quality gates passed."
